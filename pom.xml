<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.veridia</groupId>
    <artifactId>json-logic-compiler-java</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Veridia JSON Logic Compiler</name>
    <description>A high-performance JSON-Logic execution engine for the JVM (Scala 3), designed for real-time segmentation, metrics evaluation, and rule processing in the Veridia platform.</description>
    <url>https://github.com/veridia-io/json-logic-compiler-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/veridia-io/json-logic-compiler-java</url>
        <connection>scm:git:git://github.com/veridia-io/json-logic-compiler-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/veridia-io/json-logic-compiler-java.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>veridia</id>
            <name>Veridia</name>
            <email>oss@veridia.io</email>
            <organization>Veridia</organization>
            <organizationUrl>https://github.com/veridia-io</organizationUrl>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The two Java SPI files (Operator, CompiledExpression) compile against this release too,
             so scalac and javac agree on the emitted bytecode version. -->
        <maven.compiler.release>17</maven.compiler.release>

        <scala.binary.version>3</scala.binary.version>
        <scala.version>3.3.8</scala.version>
        <circe.version>0.14.16</circe.version>
        <scalatest.version>3.2.20</scalatest.version>
        <caffeine.version>3.2.4</caffeine.version>

        <jmh.version>1.37</jmh.version>
        <!-- Benchmark launcher main class; override with -Dbenchmark.main=...ComparisonBenchmark -->
        <benchmark.main>io.veridia.jsonlogic.benchmark.JsonLogicBenchmark</benchmark.main>
        <!-- JMH flags/selector passed to the launcher; override with -Dbenchmark.args="JsonLogicBenchmark -f 1 -i 3" -->
        <benchmark.args>JsonLogicBenchmark</benchmark.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_${scala.binary.version}</artifactId>
            <version>${scala.version}</version>
        </dependency>

        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-core_${scala.binary.version}</artifactId>
            <version>${circe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-parser_${scala.binary.version}</artifactId>
            <version>${circe.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.re2j</groupId>
            <artifactId>re2j</artifactId>
            <version>1.8</version>
        </dependency>

        <!-- Dependencies for tests. -->
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.binary.version}</artifactId>
            <version>${scalatest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>

        <!-- JMH microbenchmark harness (test scope; benchmark stays Java, under src/test/java). -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles the two Java SPI files (src/main/java) at the normal `compile` phase, so
                 their .class files are already on the classpath when scala-maven-plugin runs next. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.9.10</version>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <!-- Scoped strictly to Scala sources: left at its mixed-source default, this
                         plugin silently absorbs src/test/java too (compiling the JMH benchmark
                         itself via its own internal javac call), which bypasses
                         maven-compiler-plugin's annotationProcessorPaths entirely — the -Pbenchmark
                         profile's JMH annotation processor then never runs, and JMH fails at
                         startup with "Unable to find the resource: /META-INF/BenchmarkList". -->
                    <sourceDir>src/main/scala</sourceDir>
                    <testSourceDir>src/test/scala</testSourceDir>
                    <args>
                        <arg>-release:17</arg>
                        <arg>-deprecation</arg>
                        <arg>-feature</arg>
                    </args>
                </configuration>
                <executions>
                    <!-- Runs after the default `compile` phase (the Java SPI files above), so scalac
                         sees Operator.class/CompiledExpression.class already compiled. -->
                    <execution>
                        <id>scala-compile</id>
                        <phase>process-classes</phase>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <!-- src/test/java (the JMH benchmark) and src/test/scala (ScalaTest suites) both
                         only depend on already-compiled main classes, not on each other, so ordering
                         between this and maven-compiler-plugin's default-testCompile doesn't matter. -->
                    <execution>
                        <id>scala-test-compile</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>testCompile</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Runs the ported ScalaTest suites under `mvn test`. Surefire is left at its default
                 binding: with no JUnit-pattern test classes left in src/test/java (only the JMH
                 benchmark, which surefire's default includes don't match), it finds nothing to run. -->
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <version>2.2.0</version>
                <configuration>
                    <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                    <junitxml>.</junitxml>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-test</id>
                        <goals><goal>test</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <additionalJOptions>-Xdoclint:none</additionalJOptions>
                    <!-- javadoc:jar only sees src/main/java by default; the two SPI files there are
                         self-explanatory, and the Scala sources have no Java-doc surface to publish. -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GPG signing only runs when releasing (activate with -Prelease), so ordinary CI/PR
          builds — including bot/fork PRs that don't receive the signing secret — don't try to
          sign and fail. Maven Central requires signatures, so the publish step must pass -Prelease.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <useAgent>false</useAgent>
                            <gpgArguments>
                                <arg>--batch</arg>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Benchmarks are opt-in so they never slow down a normal build:
            mvn -Pbenchmark test-compile exec:exec
          Pass JMH flags through:
            mvn -Pbenchmark test-compile exec:exec -Dbenchmark.args="JsonLogicBenchmark -f 1 -wi 3 -i 5"
          This profile wires JMH's annotation processor (to generate the benchmark metadata)
          and runs the JMH launcher in a real forked JVM (exec:exec) so JMH's per-benchmark
          forks inherit the correct classpath. The benchmark itself stays plain Java
          (src/test/java) — JMH's annotation-processor-based code generation is safest left on
          javac, not folded into the Scala test compile.
        -->
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${benchmark.main}</argument>
                                <!-- Extra JMH CLI args, e.g. -Dbenchmark.args="JsonLogicBenchmark -f 1 -i 3" -->
                                <argument>${benchmark.args}</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
